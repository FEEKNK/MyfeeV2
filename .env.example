# Supabase Configuration (Client-safe public URL & Anon key — protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-Side Gemini AI Configuration (NEVER prefix with VITE_)
# Supports single key or comma/semicolon/newline separated backup keys
GEMINI_API_KEY=your-gemini-api-key
# Owner allowlist (server-side): only these Supabase account emails may use AI.
# Comma separated. Strongly recommended in production.
ALLOWED_EMAILS=you@example.com
# Optional: override Gemini model name
# GEMINI_MODEL=gemini-3.6-flash
